{
  "name": "mai-desktop-pet",
  "version": "0.4.11",
  "description": "以 MaiBot 为内核的桌面伙伴",
  "private": true,
  "license": "MIT",
  "author": "Mai Desktop Contributors",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:protocol": "npm run test:message-adapter",
    "test:large-audio": "vitest run --config vitest.large-audio.config.ts",
    "test:adapter": "vitest run --config vitest.adapter.config.ts",
    "test:message-adapter": "node scripts/test-message-adapter.mjs",
    "test:message-adapter-desktop": "node scripts/message-adapter-smoke.mjs",
    "test:plugin": "node scripts/test-plugin.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:ports": "node scripts/port-smoke.mjs",
    "test:startup": "node scripts/startup-smoke.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:bot-name": "node scripts/bot-name-smoke.mjs",
    "test:pet-bubble": "node scripts/pet-bubble-smoke.mjs",
    "test:voice-replies": "node scripts/voice-replies-smoke.mjs",
    "test:tts-buffer": "node scripts/tts-buffer-smoke.mjs",
    "test:tts-order": "node scripts/tts-order-smoke.mjs",
    "test:tts-rate": "node scripts/tts-rate-smoke.mjs",
    "test:reply-delivery": "node scripts/reply-delivery-smoke.mjs",
    "test:interaction": "node scripts/interaction-smoke.mjs",
    "test:lifecycle": "node scripts/lifecycle-smoke.mjs",
    "test:avatar-lifecycle": "node scripts/avatar-lifecycle-smoke.mjs",
    "test:model-guidance": "node scripts/model-guidance-smoke.mjs",
    "test:chat-audio": "node scripts/chat-audio-smoke.mjs",
    "test:tts-clone": "node scripts/tts-clone-smoke.mjs",
    "test:voice-import": "node scripts/voice-import-smoke.mjs && node scripts/voice-import-providers-smoke.mjs",
    "test:voice-key": "node scripts/voice-key-smoke.mjs",
    "test:window-scale": "node scripts/window-scale-smoke.mjs --dev && node scripts/window-scale-smoke.mjs",
    "test:pet-drag": "node scripts/pet-drag-smoke.mjs",
    "test:pet-click-through": "node scripts/pet-click-through-smoke.mjs",
    "test:pet-shortcuts": "node scripts/pet-shortcut-smoke.mjs && node scripts/pet-shortcut-smoke.mjs --conflict",
    "test:pet-topmost": "node scripts/pet-topmost-smoke.mjs",
    "test:live2d": "node scripts/live2d-smoke.mjs",
    "test:live2d-compat": "node scripts/live2d-compat-smoke.mjs",
    "test:server-desktop": "node scripts/server-desktop-smoke.mjs",
    "test:qq-login": "node scripts/qq-login-smoke.mjs",
    "test:local-server": "node scripts/local-server-smoke.mjs",
    "test:portable": "node scripts/portable-smoke.mjs",
    "test:installer": "pwsh -NoProfile -File scripts/installer-smoke.ps1",
    "verify:release": "node scripts/verify-release.mjs",
    "format": "prettier --write electron shared src tests scripts *.ts package.json tsconfig.json index.html",
    "dist:adapter": "node scripts/package-message-adapter.mjs",
    "dist:plugin-adapter": "node scripts/package-adapter.mjs",
    "dist:win": "npm run build && npm run dist:adapter && node scripts/package-win.mjs",
    "dist:mac": "npm run build && node scripts/package-mac.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.2",
    "lucide-react": "^0.468.0",
    "pixi-live2d-display": "npm:pixi-live2d-display-lipsyncpatch@0.5.0-ls-8",
    "pixi.js": "7.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.179.1",
    "three-stdlib": "^2.36.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.179.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "41.10.6",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@electron/get": "^5.0.0"
  },
  "build": {
    "appId": "cn.maibot.desktop-pet",
    "productName": "Mai 桌面伙伴",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Mai-Desktop-Pet-${version}-win-x64.exe"
    },
    "nsis": {
      "artifactName": "Mai-Desktop-Pet-${version}-win-x64-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mai 桌面伙伴",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "mac": {
      "icon": "resources/icon.svg",
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Mai-Desktop-Pet-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "允许 Mai 桌面伙伴录制语音，发送给你配置的语音识别服务。",
        "NSCameraUsageDescription": "允许 Mai 桌面伙伴在你开启视觉功能时使用摄像头。"
      }
    },
    "dmg": {
      "sign": false
    }
  }
}
